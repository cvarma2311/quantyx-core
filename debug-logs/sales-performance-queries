###############################
TARGET_TMT_SALES

SELECT  ROUND(SUM("M60_LEVEL_METADATA"."TARGET_QTY_TMT")::numeric,2) AS "TARGET_TMT_SALES" ,
month_name FROM "M60_LEVEL_METADATA"  where  "SBU_Name" = 'Lubes'  AND "SBU_Name" != '0' AND
"SBU_Name" not in ('Common','Mumbai Ref','Renewable Energy','Visakh Ref') AND
 "year_monthname"::DATE BETWEEN '2025-04-01' AND '2026-03-30'  GROUP BY month_name